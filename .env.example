# ============================================================================
# InstaCloud — fill in the REQUIRED block, then `npm install && npm run db:migrate && npm run dev`
# ============================================================================

# ---------- REQUIRED ----------

# Supabase  (https://supabase.com -> Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# anon / publishable key. Never use the service_role or secret key here.
SUPABASE_ANON_KEY=

# Supabase Postgres  (Project -> Connect -> "Transaction pooler" connection string, port 6543)
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# Upstash Redis  (https://upstash.com -> create database -> "TCP" / ioredis URL, starts with rediss://)
# Local alternative: redis://localhost:6379  (docker compose --profile local-redis up redis)
REDIS_URL=rediss://default:YOUR-PASSWORD@YOUR-ENDPOINT.upstash.io:6379

# Cloudinary  (https://cloudinary.com -> Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- OPTIONAL (features switch on when set) ----------

# Resend: welcome emails (https://resend.com). Without your own verified domain, Resend only
# delivers to your own account email when sending from onboarding@resend.dev.
RESEND_API_KEY=
RESEND_FROM=InstaCloud <onboarding@resend.dev>

# Sentry: error tracking for API + worker (https://sentry.io -> Node.js project -> DSN)
SENTRY_DSN=

# Grafana Cloud / Prometheus: protect GET /metrics with a bearer token (recommended in production)
METRICS_TOKEN=

# ---------- DEFAULTS (change when deploying) ----------
PORT=4000
# Browser origin(s) allowed by CORS (comma-separated)
WEB_ORIGIN=http://localhost:3000
# URL the browser uses to reach the API (baked into the web build)
API_PUBLIC_URL=http://localhost:4000
# Set to 1 when the API runs behind a proxy (Render, Cloud Run, NGINX) so rate limiting sees real client IPs
TRUST_PROXY=false
# true = run the background worker inside the API process (one free-tier container instead of two)
INLINE_WORKER=false
